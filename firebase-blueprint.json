{
  "entities": {
    "application": {
      "title": "Application",
      "description": "Job application item tracked by a job seeker",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "company": { "type": "string" },
        "role": { "type": "string" },
        "platform": { "type": "string" },
        "dateApplied": { "type": "string" },
        "status": { "type": "string" },
        "jobLink": { "type": "string" },
        "notes": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contacts": { 
          "type": "array",
          "items": { "type": "object" }
        },
        "tasks": {
          "type": "array",
          "items": { "type": "object" }
        },
        "emails": {
          "type": "array",
          "items": { "type": "object" }
        },
        "history": {
          "type": "array",
          "items": { "type": "object" }
        },
        "stageUpdatedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "company", "role", "platform", "dateApplied", "status"]
    }
  },
  "firestore": {
    "users/{userId}/applications": {
      "entity": "application",
      "schema": "users/{userId}/applications/{applicationId}"
    }
  }
}
