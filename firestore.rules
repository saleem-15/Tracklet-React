rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidStatus(status) {
      return status in ['Saved', 'Applied', 'Screening', 'Interview', 'Offer', 'Rejected', 'Archived'];
    }

    function isValidApplication(data) {
      return (data.company is string && data.company.size() > 0 && data.company.size() <= 200)
        && (data.role is string && data.role.size() > 0 && data.role.size() <= 200)
        && (data.status is string && isValidStatus(data.status))
        && (data.platform is string && data.platform.size() > 0 && data.platform.size() <= 100)
        && (data.dateApplied is string && data.dateApplied.size() > 0 && data.dateApplied.size() <= 40)
        && (!('userId' in data) || data.userId == null || (data.userId is string && data.userId == request.auth.uid))
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 20000))
        && (!('jobLink' in data) || data.jobLink == null || (data.jobLink is string && data.jobLink.size() <= 3000))
        && (!('companyDomain' in data) || data.companyDomain == null || (data.companyDomain is string && data.companyDomain.size() <= 200))
        && (!('contactEmail' in data) || data.contactEmail == null || (data.contactEmail is string && data.contactEmail.size() <= 200))
        && (!('contacts' in data) || data.contacts == null || (data.contacts is list && data.contacts.size() <= 50))
        && (!('contactIds' in data) || data.contactIds == null || (data.contactIds is list && data.contactIds.size() <= 100))
        && (!('tasks' in data) || data.tasks == null || (data.tasks is list && data.tasks.size() <= 100))
        && (!('emails' in data) || data.emails == null || (data.emails is list && data.emails.size() <= 100))
        && (!('history' in data) || data.history == null || (data.history is list && data.history.size() <= 100));
    }

    function isValidContact(data) {
      return (data.name is string && data.name.size() > 0 && data.name.size() <= 200)
        && (!('userId' in data) || data.userId == null || (data.userId is string && data.userId == request.auth.uid))
        && (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 50))
        && (!('role' in data) || data.role == null || (data.role is string && data.role.size() <= 200))
        && (!('organization' in data) || data.organization == null || (data.organization is string && data.organization.size() <= 200))
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200))
        && (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50))
        && (!('linkedIn' in data) || data.linkedIn == null || (data.linkedIn is string && data.linkedIn.size() <= 1000))
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 20000))
        && (!('nextFollowUpDate' in data) || data.nextFollowUpDate == null || (data.nextFollowUpDate is string && data.nextFollowUpDate.size() <= 40))
        && (!('applicationIds' in data) || data.applicationIds == null || (data.applicationIds is list && data.applicationIds.size() <= 100));
    }

    function isValidFeedback(data) {
      return (data.title is string && data.title.size() >= 3 && data.title.size() <= 300)
        && (data.description is string && data.description.size() >= 10 && data.description.size() <= 20000)
        && (data.type is string && data.type in ['bug', 'feature_request', 'ux_improvement', 'visual_glitch', 'other'])
        && (data.severity is string && data.severity in ['low', 'medium', 'high', 'blocker'])
        && (data.createdAt is string)
        && (data.status is string && data.status == 'new');
    }

    // User document, User Applications & User Contacts Sub-collections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /applications/{applicationId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidApplication(request.resource.data);
      }

      match /contacts/{contactId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidContact(request.resource.data);
      }
    }

    // Tester Feedback & Bug Reports
    match /tester_feedback/{reportId} {
      // Anyone (authenticated user or beta guest tester) can log a report with valid structure
      allow create: if isValidFeedback(request.resource.data);
      // Authenticated users can read feedback entries
      allow read: if isAuthenticated();
      // Reports cannot be overwritten or deleted from client
      allow update, delete: if false;
    }

    // Explicit default-deny for all unmatched root and collection paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}