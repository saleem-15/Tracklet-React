{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReportIssueApiContract",
  "description": "API Contract for POST /api/report-issue (Vercel Serverless Function to GitHub Issues)",
  "type": "object",
  "required": ["type", "title", "description", "diagnostics"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["bug", "visual_glitch", "feature_request", "general_feedback"]
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "blocker"],
      "default": "medium"
    },
    "reporterName": {
      "type": "string",
      "maxLength": 80
    },
    "reporterEmail": {
      "type": "string",
      "format": "email"
    },
    "diagnostics": {
      "type": "object",
      "required": ["appVersion", "activeTab", "browser", "os", "viewport", "authMode"],
      "properties": {
        "appVersion": { "type": "string" },
        "activeTab": { "type": "string" },
        "url": { "type": "string" },
        "browser": { "type": "string" },
        "os": { "type": "string" },
        "viewport": { "type": "string" },
        "devicePixelRatio": { "type": "number" },
        "authMode": { "type": "string", "enum": ["authenticated", "guest"] },
        "recentErrors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "screenshotUrl": {
      "type": "string",
      "format": "uri",
      "description": "Optional Firebase Storage public download URL of attached screenshot"
    }
  },
  "response": {
    "201": {
      "type": "object",
      "required": ["success", "issueNumber", "issueUrl"],
      "properties": {
        "success": { "type": "boolean", "const": true },
        "issueNumber": { "type": "integer" },
        "issueUrl": { "type": "string", "format": "uri" },
        "message": { "type": "string" }
      }
    },
    "400": {
      "type": "object",
      "required": ["error", "message"],
      "properties": {
        "error": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "500": {
      "type": "object",
      "required": ["error", "message"],
      "properties": {
        "error": { "type": "string" },
        "message": { "type": "string" },
        "fallbackUrl": { "type": "string", "description": "Pre-filled GitHub Issue URL template when API dispatch fails" }
      }
    }
  }
}
