{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrackletExtensionHandshakeContract",
  "description": "Bi-directional window postMessage contract between Tracklet Web App and Tracklet Companion Content Script",
  "definitions": {
    "PingMessage": {
      "type": "object",
      "required": ["type", "timestamp"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["TRACKLET_EXT_PING"]
        },
        "timestamp": {
          "type": "number",
          "description": "Epoch timestamp in ms when ping was dispatched"
        }
      },
      "additionalProperties": false
    },
    "PongMessage": {
      "type": "object",
      "required": ["type", "payload"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["TRACKLET_EXT_PONG"]
        },
        "payload": {
          "type": "object",
          "required": ["installed", "version", "name"],
          "properties": {
            "installed": {
              "type": "boolean"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
