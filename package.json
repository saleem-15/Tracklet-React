{
  "name": "tracklet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "package:ext": "node scripts/package-extension.js",
    "build": "node scripts/package-extension.js && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "pages:dev": "wrangler pages dev dist",
    "pages:preview": "npm run build && wrangler pages dev dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "servers": "node .agents/skills/run-dev-server/scripts/manage-worktree-servers.cjs start",
    "servers:stop": "node .agents/skills/run-dev-server/scripts/manage-worktree-servers.cjs stop",
    "servers:status": "node .agents/skills/run-dev-server/scripts/manage-worktree-servers.cjs status",
    "mcp:agentation": "agentation-mcp server",
    "mcp:doctor": "agentation-mcp doctor",
    "audit": "node --experimental-strip-types scripts/telemetry/runAudit.ts",
    "audit:firebase": "node --experimental-strip-types scripts/telemetry/extractFirebaseAdmin.ts"
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase": "^12.16.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "posthog-js": "^1.407.2",
    "posthog-node": "^5.55.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "agentation": "^3.1.2",
    "agentation-mcp": "^1.3.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
