# ==============================================================================
# Tracklet Environment Configuration (.env.example)
#
# NOTE: Tracklet SaaS Firebase Client Config is pre-configured in
# `src/config/firebase.config.ts`. You do NOT need to specify VITE_FIREBASE_*
# variables for local development or in git worktrees unless overriding them.
#
# Copy this file to `.env.local` to provide developer tokens or custom overrides.
# ==============================================================================

# Optional Firebase Client Config Overrides (uses src/config/firebase.config.ts by default)
# VITE_FIREBASE_API_KEY="AIzaSy..."
# VITE_FIREBASE_AUTH_DOMAIN="tracklet-e3409.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="tracklet-e3409"
# VITE_FIREBASE_STORAGE_BUCKET="tracklet-e3409.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="778531535407"
# VITE_FIREBASE_APP_ID="1:778531535407:web:..."
# VITE_FIREBASE_MEASUREMENT_ID="G-..."
# VITE_FIREBASE_DATABASE_ID="(default)"

# Sentry Monitoring Config (Optional / Production)
# VITE_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# VITE_APP_VERSION="1.0.0"

# PostHog Product Analytics
# VITE_POSTHOG_KEY="phc_..."
# VITE_POSTHOG_HOST="https://eu.i.posthog.com"

# Tester Issue Reporting (GitHub Issues API)
# Generate a Personal Access Token (Fine-Grained or Classic) with 'Issues: Read and write'
# GITHUB_TOKEN="github_pat_..."
# GITHUB_REPO="saleem-15/Tracklet-React"
